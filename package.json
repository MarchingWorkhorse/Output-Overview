{
  "name": "output-overview",
  "description": "DSH 产出总览插件：统计 DSH 生成的代码行数、文档数、采纳率与成本，Web 面板展示。Output statistics for DeepSeek Harness: generated code lines, docs, adoption rates, and cost.",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "output",
    "stats",
    "adoption",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarchingWorkhorse/Output-Overview.git"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
